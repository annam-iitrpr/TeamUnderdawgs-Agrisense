.local/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
node_modules/
.next/
out/
dist/
*.tsbuildinfo
*.db
*.sqlite*
*.log
.DS_Store
playwright-report/
test-results/
playwright/.auth/
.firebase/
*.tfstate*
