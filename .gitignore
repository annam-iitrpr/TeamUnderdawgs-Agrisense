# Secrets: never stage environment files, credentials, or local identities.
.env
.env.*
*.env
*.env.*
**/*service-account*.json
**/*service_account*.json
**/credentials*.json
*.pem
*.key
*.p12
*.pfx
# README publication requires explicit user authorization.
[Rr][Ee][Aa][Dd][Mm][Ee]*
